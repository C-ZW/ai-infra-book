{
  "providers": [
    {
      "family": "openai",
      "command": [
        "codex",
        "exec",
        "--skip-git-repo-check",
        "--ephemeral",
        "--sandbox",
        "read-only",
        "-m",
        "gpt-6.2-sol",
        "-c",
        "model_reasoning_effort=\"low\"",
        "--output-last-message",
        "{output}",
        "-"
      ]
    },
    {
      "family": "google",
      "command": [
        "agy",
        "--model",
        "gemini-4-argon-low",
        "--output-format",
        "text",
        "--print",
        "{prompt}"
      ]
    },
    {
      "family": "anthropic",
      "command": [
        "agy",
        "--model",
        "claude-opus-5-5-medium",
        "--output-format",
        "text",
        "--print",
        "{prompt}"
      ]
    }
  ]
}
